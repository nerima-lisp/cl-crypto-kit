(in-package #:crypto-kit)

(declaim (inline %aes-xtime %aes-gf-mul %aes-sbox
                 %aes-ct64-word-le %aes-ct64-interleave-words
                 %aes-ct64-interleave-block %aes-ct64-interleave-out
                 %aes-ct64-swapn %aes-ct64-ortho %aes-ct64-shift-rows
                 %aes-ct64-mix-columns)
         (ftype (function ((unsigned-byte 8)) (unsigned-byte 8))
                %aes-xtime %aes-sbox)
         (ftype (function ((unsigned-byte 8) (unsigned-byte 8))
                          (unsigned-byte 8))
                %aes-gf-mul))

(defstruct (aes-context
             (:constructor %make-aes-context (round-keys rounds bitsliced-round-keys)))
  round-keys rounds bitsliced-round-keys)

(defun %aes-xtime (x)
  (declare (type (unsigned-byte 8) x))
  (logand #xff
          (logxor (ash x 1)
                  (logand #x1b (- (ash x -7))))))

(defun %aes-gf-mul (a b)
  (declare (type (unsigned-byte 8) a b))
  (let ((r 0))
    (declare (type (unsigned-byte 8) r))
    (dotimes (i 8 r)
      (setf r (logxor r (logand a (- (logand b 1)))))
      (setf a (%aes-xtime a) b (ash b -1)))))

(defun %aes-sbox (x)
  ;; The inverse is x^254.  This fixed addition chain also maps zero to zero,
  ;; so S-box evaluation has no input-dependent branch or table lookup.
  (declare (type (unsigned-byte 8) x))
  (let* ((x (logand x #xff))
         (x2 (%aes-gf-mul x x))
         (x4 (%aes-gf-mul x2 x2))
         (x8 (%aes-gf-mul x4 x4))
         (x16 (%aes-gf-mul x8 x8))
         (x32 (%aes-gf-mul x16 x16))
         (x64 (%aes-gf-mul x32 x32))
         (x128 (%aes-gf-mul x64 x64))
         (y (%aes-gf-mul
             (%aes-gf-mul (%aes-gf-mul x2 x4) x8)
             (%aes-gf-mul (%aes-gf-mul x16 x32)
                          (%aes-gf-mul x64 x128)))))
    (flet ((rot (n) (logand #xff (logior (ash y n) (ash y (- n 8))))))
      (logand #xff (logxor y (rot 1) (rot 2) (rot 3) (rot 4) #x63)))))

(defun %aes-sub-word (word)
  (logior (ash (%aes-sbox (ldb (byte 8 24) word)) 24)
          (ash (%aes-sbox (ldb (byte 8 16) word)) 16)
          (ash (%aes-sbox (ldb (byte 8 8) word)) 8)
          (%aes-sbox (ldb (byte 8 0) word))))

(defun %aes-key-expansion (key)
  (let* ((nk (/ (length key) 4)) (nr (+ nk 6))
         (words (make-array (* 4 (1+ nr)) :element-type '(unsigned-byte 32)))
         (rcon 1))
    (dotimes (i nk) (setf (aref words i)
                          (logior (ash (aref key (* i 4)) 24)
                                  (ash (aref key (+ (* i 4) 1)) 16)
                                  (ash (aref key (+ (* i 4) 2)) 8)
                                  (aref key (+ (* i 4) 3)))))
    (loop for i from nk below (length words) do
      (let ((temp (aref words (1- i))))
        (when (zerop (mod i nk))
          (setf temp (logior (ash (ldb (byte 8 16) temp) 24)
                             (ash (ldb (byte 8 8) temp) 16)
                             (ash (ldb (byte 8 0) temp) 8)
                             (ldb (byte 8 24) temp)))
          (setf temp (logxor (%aes-sub-word temp) (ash rcon 24)))
          (setf rcon (%aes-xtime rcon)))
        (when (and (= nk 8) (= (mod i nk) 4))
          (setf temp (%aes-sub-word temp)))
        (setf (aref words i) (logxor (aref words (- i nk)) temp))))
    (values words nr)))
(defun %aes-ct64-word-le (word)
  (declare (type (unsigned-byte 32) word)
           (optimize (speed 3) (safety 0) (debug 0)))
  (logior (ldb (byte 8 24) word)
          (ash (ldb (byte 8 16) word) 8)
          (ash (ldb (byte 8 8) word) 16)
          (ash (ldb (byte 8 0) word) 24)))
(defun %aes-ct64-interleave-words (q block-index w0 w1 w2 w3)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (type fixnum block-index)
           (type (unsigned-byte 32) w0 w1 w2 w3)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let* ((x0 (logand #x0000ffff0000ffff (logior w0 (ash w0 16))))
         (x1 (logand #x0000ffff0000ffff (logior w1 (ash w1 16))))
         (x2 (logand #x0000ffff0000ffff (logior w2 (ash w2 16))))
         (x3 (logand #x0000ffff0000ffff (logior w3 (ash w3 16)))))
    (declare (type (unsigned-byte 64) x0 x1 x2 x3))
    (setf x0 (logand #x00ff00ff00ff00ff (logior x0 (ash x0 8)))
          x1 (logand #x00ff00ff00ff00ff (logior x1 (ash x1 8)))
          x2 (logand #x00ff00ff00ff00ff (logior x2 (ash x2 8)))
          x3 (logand #x00ff00ff00ff00ff (logior x3 (ash x3 8))))
    (setf (aref q block-index) (logior x0 (ash x2 8))
          (aref q (+ block-index 4)) (logior x1 (ash x3 8))))
  q)
(defun %aes-ct64-interleave-block (q block-index block)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (type fixnum block-index)
           (type (simple-array (unsigned-byte 8) (16)) block)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let ((w0 (logior (aref block 0) (ash (aref block 1) 8)
                    (ash (aref block 2) 16) (ash (aref block 3) 24)))
        (w1 (logior (aref block 4) (ash (aref block 5) 8)
                    (ash (aref block 6) 16) (ash (aref block 7) 24)))
        (w2 (logior (aref block 8) (ash (aref block 9) 8)
                    (ash (aref block 10) 16) (ash (aref block 11) 24)))
        (w3 (logior (aref block 12) (ash (aref block 13) 8)
                    (ash (aref block 14) 16) (ash (aref block 15) 24))))
    (declare (type (unsigned-byte 32) w0 w1 w2 w3))
    (%aes-ct64-interleave-words q block-index w0 w1 w2 w3)))
(defun %aes-ct64-interleave-out (q block-index block)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (type fixnum block-index)
           (type (simple-array (unsigned-byte 8) (16)) block)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let* ((q0 (aref q block-index))
         (q1 (aref q (+ block-index 4)))
         (x0 (logand q0 #x00ff00ff00ff00ff))
         (x1 (logand q1 #x00ff00ff00ff00ff))
         (x2 (logand (ash q0 -8) #x00ff00ff00ff00ff))
         (x3 (logand (ash q1 -8) #x00ff00ff00ff00ff)))
    (declare (type (unsigned-byte 64) q0 q1 x0 x1 x2 x3))
    (setf x0 (logand #x0000ffff0000ffff (logior x0 (ash x0 -8)))
          x1 (logand #x0000ffff0000ffff (logior x1 (ash x1 -8)))
          x2 (logand #x0000ffff0000ffff (logior x2 (ash x2 -8)))
          x3 (logand #x0000ffff0000ffff (logior x3 (ash x3 -8))))
    (let ((w0 (logand #xffffffff (logior x0 (ash x0 -16))))
          (w1 (logand #xffffffff (logior x1 (ash x1 -16))))
          (w2 (logand #xffffffff (logior x2 (ash x2 -16))))
          (w3 (logand #xffffffff (logior x3 (ash x3 -16)))))
      (declare (type (unsigned-byte 32) w0 w1 w2 w3))
      (setf (aref block 0) (ldb (byte 8 0) w0)
            (aref block 1) (ldb (byte 8 8) w0)
            (aref block 2) (ldb (byte 8 16) w0)
            (aref block 3) (ldb (byte 8 24) w0)
            (aref block 4) (ldb (byte 8 0) w1)
            (aref block 5) (ldb (byte 8 8) w1)
            (aref block 6) (ldb (byte 8 16) w1)
            (aref block 7) (ldb (byte 8 24) w1)
            (aref block 8) (ldb (byte 8 0) w2)
            (aref block 9) (ldb (byte 8 8) w2)
            (aref block 10) (ldb (byte 8 16) w2)
            (aref block 11) (ldb (byte 8 24) w2)
            (aref block 12) (ldb (byte 8 0) w3)
            (aref block 13) (ldb (byte 8 8) w3)
            (aref block 14) (ldb (byte 8 16) w3)
            (aref block 15) (ldb (byte 8 24) w3))))
  block)
(defun %aes-ct64-swapn (q low high shift first second)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (type (unsigned-byte 64) low high)
           (type fixnum first second)
           (type (member 1 2 4) shift)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let* ((a (aref q first))
         (b (aref q second))
         (mask-1 (- (logand shift 1)))
         (mask-2 (- (ash (logand shift 2) -1)))
         (mask-4 (- (ash (logand shift 4) -2)))
         (a-low (logand a low))
         (b-low (logand b low))
         (a-high (logand a high))
         (b-high (logand b high))
         (left-shifted
           (logior
            (logand (ash (logand b-low #x7fffffffffffffff) 1) mask-1)
            (logand (ash (logand b-low #x3fffffffffffffff) 2) mask-2)
            (logand (ash (logand b-low #x0fffffffffffffff) 4) mask-4)))
         (right-shifted
           (logior
            (logand (ash a-high -1) mask-1)
            (logand (ash a-high -2) mask-2)
            (logand (ash a-high -4) mask-4))))
    (setf (aref q first) (logior a-low left-shifted)
          (aref q second) (logior right-shifted b-high)))
  q)
(defun %aes-ct64-ortho (q)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (optimize (speed 3) (safety 0) (debug 0)))
  (%aes-ct64-swapn q #x5555555555555555 #xaaaaaaaaaaaaaaaa 1 0 1)
  (%aes-ct64-swapn q #x5555555555555555 #xaaaaaaaaaaaaaaaa 1 2 3)
  (%aes-ct64-swapn q #x5555555555555555 #xaaaaaaaaaaaaaaaa 1 4 5)
  (%aes-ct64-swapn q #x5555555555555555 #xaaaaaaaaaaaaaaaa 1 6 7)
  (%aes-ct64-swapn q #x3333333333333333 #xcccccccccccccccc 2 0 2)
  (%aes-ct64-swapn q #x3333333333333333 #xcccccccccccccccc 2 1 3)
  (%aes-ct64-swapn q #x3333333333333333 #xcccccccccccccccc 2 4 6)
  (%aes-ct64-swapn q #x3333333333333333 #xcccccccccccccccc 2 5 7)
  (%aes-ct64-swapn q #x0f0f0f0f0f0f0f0f #xf0f0f0f0f0f0f0f0 4 0 4)
  (%aes-ct64-swapn q #x0f0f0f0f0f0f0f0f #xf0f0f0f0f0f0f0f0 4 1 5)
  (%aes-ct64-swapn q #x0f0f0f0f0f0f0f0f #xf0f0f0f0f0f0f0f0 4 2 6)
  (%aes-ct64-swapn q #x0f0f0f0f0f0f0f0f #xf0f0f0f0f0f0f0f0 4 3 7)
  q)
(defun %aes-ct64-shift-rows (q)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (optimize (speed 3) (safety 0) (debug 0)))
  (dotimes (i 8 q)
    (let ((x (aref q i)))
      (declare (type (unsigned-byte 64) x))
      (setf (aref q i)
            (logior (logand x #x000000000000ffff)
                    (ash (logand x #x00000000fff00000) -4)
                    (ash (logand x #x00000000000f0000) 12)
                    (ash (logand x #x0000ff0000000000) -8)
                    (ash (logand x #x000000ff00000000) 8)
                    (ash (logand x #xf000000000000000) -12)
                    (ash (logand x #x0fff000000000000) 4))))))
(defmacro %aes-ct64-rotr32 (x)
  (let ((value (gensym "VALUE")))
    `(let ((,value ,x))
       (declare (type (unsigned-byte 64) ,value))
       (logand #xffffffffffffffff
               (logior (ash ,value 32) (ash ,value -32))))))
(defun %aes-ct64-mix-columns (q)
  (declare (type (simple-array (unsigned-byte 64) (8)) q)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let* ((q0 (aref q 0)) (q1 (aref q 1))
         (q2 (aref q 2)) (q3 (aref q 3))
         (q4 (aref q 4)) (q5 (aref q 5))
         (q6 (aref q 6)) (q7 (aref q 7))
         (r0 (logior (ash q0 -16) (logand #xffffffffffffffff (ash q0 48))))
         (r1 (logior (ash q1 -16) (logand #xffffffffffffffff (ash q1 48))))
         (r2 (logior (ash q2 -16) (logand #xffffffffffffffff (ash q2 48))))
         (r3 (logior (ash q3 -16) (logand #xffffffffffffffff (ash q3 48))))
         (r4 (logior (ash q4 -16) (logand #xffffffffffffffff (ash q4 48))))
         (r5 (logior (ash q5 -16) (logand #xffffffffffffffff (ash q5 48))))
         (r6 (logior (ash q6 -16) (logand #xffffffffffffffff (ash q6 48))))
         (r7 (logior (ash q7 -16) (logand #xffffffffffffffff (ash q7 48)))))
    (declare (type (unsigned-byte 64)
                   q0 q1 q2 q3 q4 q5 q6 q7 r0 r1 r2 r3 r4 r5 r6 r7))
    (setf (aref q 0) (logxor q7 r7 r0 (%aes-ct64-rotr32 (logxor q0 r0)))
          (aref q 1) (logxor q0 r0 q7 r7 r1 (%aes-ct64-rotr32 (logxor q1 r1)))
          (aref q 2) (logxor q1 r1 r2 (%aes-ct64-rotr32 (logxor q2 r2)))
          (aref q 3) (logxor q2 r2 q7 r7 r3 (%aes-ct64-rotr32 (logxor q3 r3)))
          (aref q 4) (logxor q3 r3 q7 r7 r4 (%aes-ct64-rotr32 (logxor q4 r4)))
          (aref q 5) (logxor q4 r4 r5 (%aes-ct64-rotr32 (logxor q5 r5)))
          (aref q 6) (logxor q5 r5 r6 (%aes-ct64-rotr32 (logxor q6 r6)))
          (aref q 7) (logxor q6 r6 r7 (%aes-ct64-rotr32 (logxor q7 r7)))))
  q)
(defun %aes-ct64-expand-round-keys (round-keys rounds)
  (declare (type (simple-array (unsigned-byte 32) (*)) round-keys)
           (type fixnum rounds)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let ((expanded (make-array (* 8 (1+ rounds))
                              :element-type '(unsigned-byte 64)))
        (q (make-array 8 :element-type '(unsigned-byte 64)
                       :initial-element 0)))
    (declare (type (simple-array (unsigned-byte 64) (*)) expanded)
             (type (simple-array (unsigned-byte 64) (8)) q))
    (dotimes (round (1+ rounds) expanded)
      (let ((offset (* round 4)))
        (%aes-ct64-interleave-words
         q 0
         (%aes-ct64-word-le (aref round-keys offset))
         (%aes-ct64-word-le (aref round-keys (+ offset 1)))
         (%aes-ct64-word-le (aref round-keys (+ offset 2)))
         (%aes-ct64-word-le (aref round-keys (+ offset 3))))
        (setf (aref q 1) (aref q 0)
              (aref q 2) (aref q 0)
              (aref q 3) (aref q 0)
              (aref q 5) (aref q 4)
              (aref q 6) (aref q 4)
              (aref q 7) (aref q 4))
        (%aes-ct64-ortho q)
        (dotimes (word 8)
          (setf (aref expanded (+ (* round 8) word))
                (aref q word)))))))
(defun %aes-encrypt-four-blocks-into
    (ctx block0 block1 block2 block3 output0 output1 output2 output3 planes)
  (declare (type aes-context ctx)
           (type (simple-array (unsigned-byte 8) (16))
                 block0 block1 block2 block3 output0 output1 output2 output3)
           (type (simple-array (unsigned-byte 64) (8)) planes)
           (optimize (speed 3) (safety 0) (debug 0)))
  (let ((keys (aes-context-bitsliced-round-keys ctx))
        (rounds (aes-context-rounds ctx)))
    (declare (type (simple-array (unsigned-byte 64) (*)) keys)
             (type (integer 10 14) rounds))
    (%aes-ct64-interleave-block planes 0 block0)
    (%aes-ct64-interleave-block planes 1 block1)
    (%aes-ct64-interleave-block planes 2 block2)
    (%aes-ct64-interleave-block planes 3 block3)
    (%aes-ct64-ortho planes)
    (dotimes (word 8)
      (setf (aref planes word)
            (logxor (aref planes word) (aref keys word))))
    (let ((key-offset 8))
      (declare (type (integer 8 112) key-offset))
      (dotimes (round (1- rounds))
        (declare (type (integer 0 13) round))
        (%aes-bitslice-sbox planes)
        (%aes-ct64-shift-rows planes)
        (%aes-ct64-mix-columns planes)
        (let ((key-index key-offset))
          (declare (type (integer 8 112) key-index))
          (dotimes (word 8)
            (declare (type (integer 0 8) word))
            (setf (aref planes word)
                  (logxor (aref planes word) (aref keys key-index)))
            (incf key-index)))
        (incf key-offset 8))
      (%aes-bitslice-sbox planes)
      (%aes-ct64-shift-rows planes)
      (let ((key-index key-offset))
        (declare (type (integer 8 112) key-index))
        (dotimes (word 8)
          (declare (type (integer 0 8) word))
          (setf (aref planes word)
                (logxor (aref planes word) (aref keys key-index)))
          (incf key-index)))
      (%aes-ct64-ortho planes)
      (%aes-ct64-interleave-out planes 0 output0)
      (%aes-ct64-interleave-out planes 1 output1)
      (%aes-ct64-interleave-out planes 2 output2)
      (%aes-ct64-interleave-out planes 3 output3)
      output0)))

(defun %aes-make (key size)
  (unless (= (length key) size) (error "AES~D requires a ~D-byte key" (* 8 size) size))
  (multiple-value-bind (round-keys rounds) (%aes-key-expansion key)
    (%make-aes-context round-keys rounds (%aes-ct64-expand-round-keys round-keys rounds))))

(defun aes-128 (key) (%aes-make key 16))
(defun aes-192 (key) (%aes-make key 24))
(defun aes-256 (key) (%aes-make key 32))

(defun %aes-add-round-key (state keys round)
  (declare (type (simple-array (unsigned-byte 8) (16)) state)
           (type (simple-array (unsigned-byte 32) (*)) keys)
           (type fixnum round)
           (optimize (speed 3) (safety 1) (debug 1)))
  (dotimes (c 4)
    (let ((word (aref keys (+ (* round 4) c))))
      (dotimes (r 4)
        (setf (aref state (+ (* c 4) r))
              (logxor (aref state (+ (* c 4) r))
                      (ldb (byte 8 (* 8 (- 3 r))) word)))))))

(defun %aes-sub-bytes (state planes)
  (declare (type (simple-array (unsigned-byte 8) (16)) state)
           (type (simple-array (unsigned-byte 64) (8)) planes)
           (optimize (speed 3) (safety 1) (debug 1)))
  (fill planes 0)
  (dotimes (index 16)
    (let ((value (aref state index)))
      (dotimes (bit 8)
        (setf (aref planes bit)
              (logior (aref planes bit)
                      (ash (ldb (byte 1 bit) value) index))))))
  (%aes-bitslice-sbox planes)
  (dotimes (index 16)
    (let ((value 0))
      (dotimes (bit 8)
        (setf value (logior value (ash (ldb (byte 1 index) (aref planes bit)) bit))))
      (setf (aref state index) value)))
  state)
(defun %aes-sub-bytes-2 (state1 state2 planes)
  (declare (type (simple-array (unsigned-byte 8) (16)) state1 state2)
           (type (simple-array (unsigned-byte 64) (8)) planes)
           (optimize (speed 3) (safety 1) (debug 1)))
  (fill planes 0)
  (dotimes (index 16)
    (let ((value1 (aref state1 index))
          (value2 (aref state2 index)))
      (dotimes (bit 8)
        (setf (aref planes bit)
              (logior (aref planes bit)
                      (ash (ldb (byte 1 bit) value1) index)
                      (ash (ldb (byte 1 bit) value2) (+ index 16)))))))
  (%aes-bitslice-sbox planes)
  (dotimes (index 16)
    (let ((value1 0)
          (value2 0))
      (dotimes (bit 8)
        (setf value1
              (logior value1
                      (ash (ldb (byte 1 index) (aref planes bit)) bit))
              value2
              (logior value2
                      (ash (ldb (byte 1 (+ index 16)) (aref planes bit)) bit))))
      (setf (aref state1 index) value1
            (aref state2 index) value2)))
  state1)

(defun %aes-shift-rows (s)
  (declare (type (simple-array (unsigned-byte 8) (16)) s)
           (optimize (speed 3) (safety 1) (debug 1)))
  (let ((a1 (aref s 1)) (a5 (aref s 5)) (a9 (aref s 9)) (a13 (aref s 13))
        (a2 (aref s 2)) (a6 (aref s 6)) (a10 (aref s 10)) (a14 (aref s 14))
        (a3 (aref s 3)) (a7 (aref s 7)) (a11 (aref s 11)) (a15 (aref s 15)))
    (setf (aref s 1) a5 (aref s 5) a9 (aref s 9) a13 (aref s 13) a1
          (aref s 2) a10 (aref s 6) a14 (aref s 10) a2 (aref s 14) a6
          (aref s 3) a15 (aref s 7) a3 (aref s 11) a7 (aref s 15) a11)))

(defun %aes-mix-columns (s)
  (declare (type (simple-array (unsigned-byte 8) (16)) s)
           (optimize (speed 3) (safety 1) (debug 1)))
  (dotimes (c 4)
    (let* ((p (* c 4))
           (a0 (aref s p))
           (a1 (aref s (+ p 1)))
           (a2 (aref s (+ p 2)))
           (a3 (aref s (+ p 3)))
           (total (logxor a0 a1 a2 a3)))
      (setf (aref s p) (logxor a0 total (%aes-xtime (logxor a0 a1)))
            (aref s (+ p 1)) (logxor a1 total (%aes-xtime (logxor a1 a2)))
            (aref s (+ p 2)) (logxor a2 total (%aes-xtime (logxor a2 a3)))
            (aref s (+ p 3)) (logxor a3 total (%aes-xtime (logxor a3 a0)))))))

(defun %aes-encrypt-block-into (ctx block state planes)
  (declare (type aes-context ctx)
           (type sequence block)
           (type (simple-array (unsigned-byte 8) (16)) state)
           (type (simple-array (unsigned-byte 64) (8)) planes)
           (optimize (speed 3) (safety 1) (debug 1)))
  (replace state block)
  (let ((keys (aes-context-round-keys ctx))
        (rounds (aes-context-rounds ctx)))
    (declare (type (simple-array (unsigned-byte 32) (*)) keys)
             (type fixnum rounds))
    (unless (= (length block) 16) (error "AES blocks are 16 bytes"))
    (%aes-add-round-key state keys 0)
    (loop for round from 1 below rounds do
      (%aes-sub-bytes state planes) (%aes-shift-rows state) (%aes-mix-columns state)
      (%aes-add-round-key state keys round))
    (%aes-sub-bytes state planes) (%aes-shift-rows state) (%aes-add-round-key state keys rounds)
    state))
(defun %aes-encrypt-two-blocks-into (ctx block1 block2 state1 state2 planes)
  (declare (type aes-context ctx)
           (type sequence block1 block2)
           (type (simple-array (unsigned-byte 8) (16)) state1 state2)
           (type (simple-array (unsigned-byte 64) (8)) planes)
           (optimize (speed 3) (safety 1) (debug 1)))
  (unless (and (= (length block1) 16)
               (= (length block2) 16))
    (error "AES blocks are 16 bytes"))
  (replace state1 block1)
  (replace state2 block2)
  (let ((keys (aes-context-round-keys ctx))
        (rounds (aes-context-rounds ctx)))
    (declare (type (simple-array (unsigned-byte 32) (*)) keys)
             (type fixnum rounds))
    (%aes-add-round-key state1 keys 0)
    (%aes-add-round-key state2 keys 0)
    (loop for round from 1 below rounds do
      (%aes-sub-bytes-2 state1 state2 planes)
      (%aes-shift-rows state1)
      (%aes-shift-rows state2)
      (%aes-mix-columns state1)
      (%aes-mix-columns state2)
      (%aes-add-round-key state1 keys round)
      (%aes-add-round-key state2 keys round))
    (%aes-sub-bytes-2 state1 state2 planes)
    (%aes-shift-rows state1)
    (%aes-shift-rows state2)
    (%aes-add-round-key state1 keys rounds)
    (%aes-add-round-key state2 keys rounds)
    state1))

(defun aes-encrypt-block (cipher block)
  (let* ((ctx (if (typep cipher 'aes-context) cipher
                  (ecase (length cipher)
                    (16 (aes-128 cipher))
                    (24 (aes-192 cipher))
                    (32 (aes-256 cipher)))))
         (state (make-array 16 :element-type '(unsigned-byte 8)))
         (planes (make-array 8 :element-type '(unsigned-byte 64) :initial-element 0)))
    (%aes-encrypt-block-into ctx block state planes)))
