(in-package #:crypto-kit)

(defun der-length (v pos)
  (when (>= pos (length v)) (return-from der-length (values nil nil)))
  (let ((b (aref v pos)))
    (if (< b 128) (values b (1+ pos))
        (let ((n (logand b 127)))
          (when (or (zerop n) (> n 2) (> (+ pos 1 n) (length v))
                    (and (> n 1) (zerop (aref v (1+ pos)))))
            (return-from der-length (values nil nil)))
          (let ((length (read-be v (1+ pos) n)))
            (when (and (= n 1) (< length 128))
              (return-from der-length (values nil nil)))
            (values length (+ pos 1 n)))))))
(defun der-integer (v pos end)
  (unless (and (< pos end) (= (aref v pos) 2)) (return-from der-integer (values nil nil)))
  (multiple-value-bind (len start) (der-length v (1+ pos))
    (unless (and len start (> len 0) (<= (+ start len) end)
                 (or (and (< (aref v start) 128)
                          (or (not (zerop (aref v start)))
                              (and (> len 1) (>= (aref v (1+ start)) 128))))
                     (and (= (aref v start) 0) (> len 1)
                          (>= (aref v (1+ start)) 128))))
      (return-from der-integer (values nil nil)))
    (if (and (= (aref v start) 0) (> len 1))
        (values (read-be v (1+ start) (1- len)) (+ start len))
        (values (read-be v start len) (+ start len)))))
(defun parse-ecdsa-signature (signature)
  (unless (and (> (length signature) 6) (= (aref signature 0) 48)) (return-from parse-ecdsa-signature nil))
  (multiple-value-bind (len pos) (der-length signature 1)
    (unless (and len pos (= (+ pos len) (length signature))) (return-from parse-ecdsa-signature nil))
    (multiple-value-bind (r next) (der-integer signature pos (+ pos len))
      (when r
        (multiple-value-bind (s end) (der-integer signature next (+ pos len))
          (and s (= end (+ pos len)) (values r s)))))))

(defun ecdsa-verify (curve hash-algorithm message public-key signature)
  (let* ((c (ec-curve-for curve))
         (q (handler-case (ec-decode-point public-key c) (crypto-error () nil)))
         (parsed (and q (multiple-value-list (parse-ecdsa-signature signature)))))
    (when (and q parsed (= (length parsed) 2))
      (let ((r (first parsed)) (s (second parsed)) (n (ec-curve-n c)))
        (when (and (> r 0) (< r n) (> s 0) (< s n))
          (let* ((e (read-be (digest hash-algorithm message) 0 (digest-length hash-algorithm)))
                 (shift (- (* 8 (digest-length hash-algorithm)) (integer-length n)))
                 (z (if (> shift 0) (ash e (- shift)) e))
                 (w (ec-pow-mod s (- n 2) n))
                 (u1 (mod (* z w) n)) (u2 (mod (* r w) n))
                 (g (ec-point (ec-curve-gx c) (ec-curve-gy c)))
                 (p (ec-jacobian-affine (ec-jacobian-shamir u1 u2 g q c) c)))
            (and p (= (mod (car p) n) r))))))))
(defun ec-curve-for (curve) (case curve ((:p256 p256) +p256+) ((:p384 p384) +p384+) (otherwise (crypto-error "Unknown EC curve ~S" curve))))
(defun ecdsa-verify-p256 (message public-key signature) (ecdsa-verify :p256 :sha256 message public-key signature))
(defun ecdsa-verify-p384 (message public-key signature) (ecdsa-verify :p384 :sha384 message public-key signature))
(defun %rfc6979-p256-k-generator (private-scalar hash-bytes)
  (let* ((size (ec-curve-size +p256+))
         (context (%ec-order-context +p256+))
         (limb-count (ec-mod-context-limb-count context))
         (order-limbs (ec-mod-context-modulus-limbs context))
         (hash-limbs (%ec-limbs-from-octets hash-bytes limb-count))
         (key (make-array (digest-length :sha256)
                          :element-type '(unsigned-byte 8)
                          :initial-element 0))
         (value (make-array (digest-length :sha256)
                            :element-type '(unsigned-byte 8)
                            :initial-element 1))
         (returned nil))
    (multiple-value-bind (reduced borrow)
        (%ec-limbs-sub-raw hash-limbs order-limbs)
      (let* ((bits2octets
               (%ec-limbs-to-octets
                (%ec-limbs-select reduced hash-limbs borrow) size))
             (bx (concat-octets private-scalar bits2octets)))
        (setf key (hmac :sha256 key (concat-octets value #(0) bx)))
        (setf value (hmac :sha256 key value))
        (setf key (hmac :sha256 key (concat-octets value #(1) bx)))
        (setf value (hmac :sha256 key value))))
    (lambda ()
      (when returned
        (setf key (hmac :sha256 key (concat-octets value #(0))))
        (setf value (hmac :sha256 key value))
        (setf returned nil))
      (loop
        (setf value (hmac :sha256 key value))
        (let* ((candidate (%ec-limbs-from-octets value limb-count))
               (valid (%ec-limbs-valid-scalar-bit candidate context)))
          (when (= valid 1)
            (setf returned t)
            (return candidate)))
        ;; RFC 6979's rejection count varies (~2^-32/draw), but is independent of accepted k under HMAC's PRF model.
        (setf key (hmac :sha256 key (concat-octets value #(0))))
        (setf value (hmac :sha256 key value))))))
(defun %ecdsa-p256-candidate (private-scalar nonce message-hash)
  (let* ((context (%ec-order-context +p256+))
         (limb-count (ec-mod-context-limb-count context))
         (order-limbs (ec-mod-context-modulus-limbs context))
         (inverse-exponent
           (%ec-limbs-from-public-integer
            (- (ec-curve-n +p256+) 2) limb-count))
         (base (ec-point (ec-curve-gx +p256+) (ec-curve-gy +p256+)))
         (point (%ec-projective-affine
                 (%ec-secret-scalar-mul nonce base +p256+) +p256+))
         (x (car point)))
    (multiple-value-bind (hash-reduced hash-borrow)
        (%ec-limbs-sub-raw message-hash order-limbs)
      (multiple-value-bind (x-reduced x-borrow)
          (%ec-limbs-sub-raw x order-limbs)
        (let* ((z (%ec-limbs-select hash-reduced message-hash hash-borrow))
               (r (%ec-limbs-select x-reduced x x-borrow))
               (nonce-mont (%ec-to-montgomery nonce context))
               (private-mont (%ec-to-montgomery private-scalar context))
               (r-mont (%ec-to-montgomery r context))
               (message-mont (%ec-to-montgomery z context))
               (rd (%ec-montgomery-multiply r-mont private-mont context))
               (sum (%ec-modular-add message-mont rd context))
               (inverse (%ec-montgomery-power
                         nonce-mont inverse-exponent context
                         (* 8 (ec-curve-size +p256+))))
               (s-mont (%ec-montgomery-multiply inverse sum context))
               (s (%ec-from-montgomery s-mont context))
               (valid (logand (logxor 1 (%ec-limbs-zero-bit r))
                              (logxor 1 (%ec-limbs-zero-bit s)))))
          (values r s valid))))))
(defun %ecdsa-der-integer-limbs (integer-limbs size)
  (let* ((bytes (%ec-limbs-to-octets integer-limbs size))
         (start 0))
    (loop while (and (< start (1- size)) (zerop (aref bytes start))) do
      (incf start))
    (let* ((magnitude (subseq bytes start))
           (encoded (if (logbitp 7 (aref magnitude 0))
                        (concat-octets #(0) magnitude)
                        magnitude)))
      (concat-octets (vector 2 (length encoded)) encoded))))
(defun %ecdsa-der-signature (r s size)
  (let* ((r-bytes (%ecdsa-der-integer-limbs r size))
         (s-bytes (%ecdsa-der-integer-limbs s size))
         (body (concat-octets r-bytes s-bytes)))
    (concat-octets (vector 48 (length body)) body)))
(defun ecdsa-sign-p256 (message private-scalar)
  (unless (typep message '(vector (unsigned-byte 8)))
    (crypto-error "ECDSA message must be an octet vector"))
  (multiple-value-bind (safe-private private-valid)
      (%ec-private-scalar private-scalar +p256+)
    (unless (= private-valid 1)
      (crypto-error "Invalid P-256 private scalar"))
    (let* ((size (ec-curve-size +p256+))
           (hash-bytes (digest :sha256 message))
           (hash-limbs
             (%ec-limbs-from-octets
              hash-bytes (ec-mod-context-limb-count (%ec-order-context +p256+))))
           (next-nonce (%rfc6979-p256-k-generator private-scalar hash-bytes)))
      (loop
        (let ((nonce (funcall next-nonce)))
          (multiple-value-bind (r s valid)
              (%ecdsa-p256-candidate safe-private nonce hash-limbs)
            ;; Zero-r/s retries may add latency (~2^-256/draw), exposing only discarded-candidate invalidity.
            ;; Fixed-flow k/d arithmetic ends before that check; DER branches only on accepted public r/s.
            (when (= valid 1)
              (return (%ecdsa-der-signature r s size)))))))))
