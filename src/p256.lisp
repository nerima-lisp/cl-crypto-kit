(in-package #:crypto-kit)

(defstruct (ec-curve (:constructor make-ec-curve (prime a b gx gy n size))) prime a b gx gy n size field-context order-context field-b)
(defparameter +p256+
  (make-ec-curve #xffffffff00000001000000000000000000000000ffffffffffffffffffffffff
                 #xffffffff00000001000000000000000000000000fffffffffffffffffffffffc
                 #x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b
                 #x6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296
                 #x4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5
                 #xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551 32))

(defun ec-mod (x c) (mod x (ec-curve-prime c)))
(defun ec-pow (x e c) (let ((r 1) (b (ec-mod x c))) (loop while (> e 0) do (when (oddp e) (setf r (ec-mod (* r b) c))) (setf b (ec-mod (* b b) c) e (ash e -1))) r))
(defun ec-pow-mod (x e modulus)
  (let ((r 1) (b (mod x modulus)))
    (loop while (> e 0) do
      (when (oddp e) (setf r (mod (* r b) modulus)))
      (setf b (mod (* b b) modulus) e (ash e -1)))
    r))
(defun ec-inv (x c) (if (zerop x) 0 (ec-pow x (- (ec-curve-prime c) 2) c)))
(defun ec-point (x y) (cons x y))
(defun ec-infinity-p (q) (null q))

(defstruct (ec-jacobian (:constructor ec-jacobian (x y z))) x y z)
(defun ec-jacobian-point (q)
  (and q (ec-jacobian (car q) (cdr q) 1)))
(defun ec-jacobian-double (q c)
  (if (or (null q) (zerop (ec-jacobian-y q)))
      nil
      (let* ((x (ec-jacobian-x q)) (y (ec-jacobian-y q)) (z (ec-jacobian-z q))
             (yy (ec-mod (* y y) c))
             (s (ec-mod (* 4 x yy) c))
             (m (ec-mod (+ (* 3 x x)
                           (* (ec-curve-a c) (expt z 4))) c))
             (nx (ec-mod (- (* m m) (* 2 s)) c))
             (ny (ec-mod (- (* m (- s nx)) (* 8 yy yy)) c))
             (nz (ec-mod (* 2 y z) c)))
        (ec-jacobian nx ny nz))))
(defun ec-jacobian-add (left right c)
  (cond ((null left) right) ((null right) left)
        (t (let* ((z1 (ec-jacobian-z left)) (z2 (ec-jacobian-z right))
                  (z1sq (ec-mod (* z1 z1) c)) (z2sq (ec-mod (* z2 z2) c))
                  (u1 (ec-mod (* (ec-jacobian-x left) z2sq) c))
                  (u2 (ec-mod (* (ec-jacobian-x right) z1sq) c))
                  (s1 (ec-mod (* (ec-jacobian-y left) z2 z2sq) c))
                  (s2 (ec-mod (* (ec-jacobian-y right) z1 z1sq) c)))
             (if (= u1 u2)
                 (if (= s1 s2) (ec-jacobian-double left c) nil)
                 (let* ((h (ec-mod (- u2 u1) c))
                        (r (ec-mod (- s2 s1) c))
                        (h2 (ec-mod (* h h) c))
                        (h3 (ec-mod (* h h2) c))
                        (nx (ec-mod (- (* r r) h3 (* 2 u1 h2)) c))
                        (ny (ec-mod (- (* r (- (* u1 h2) nx)) (* s1 h3)) c))
                        (nz (ec-mod (* h z1 z2) c)))
                   (ec-jacobian nx ny nz)))))))
(defun ec-jacobian-shamir (u1 u2 g q c)
  (let* ((gp (ec-jacobian-point g))
         (qp (ec-jacobian-point q))
         (gq (ec-jacobian-add gp qp c))
         (r nil)
         (bits (max (integer-length u1) (integer-length u2))))
    (loop for i downfrom (1- bits) to 0 do
      (setf r (ec-jacobian-double r c))
      (case (+ (if (logbitp i u1) 2 0) (if (logbitp i u2) 1 0))
        (1 (setf r (ec-jacobian-add r qp c)))
        (2 (setf r (ec-jacobian-add r gp c)))
        (3 (setf r (ec-jacobian-add r gq c)))))
    r))
(defun ec-jacobian-cswap (left right bit)
  (let* ((mask (- bit))
         (lx (if left (ec-jacobian-x left) 0))
         (ly (if left (ec-jacobian-y left) 0))
         (lz (if left (ec-jacobian-z left) 0))
         (rx (if right (ec-jacobian-x right) 0))
         (ry (if right (ec-jacobian-y right) 0))
         (rz (if right (ec-jacobian-z right) 0))
         (lf (if left 1 0)) (rf (if right 1 0))
         (dx (logand mask (logxor lx rx)))
         (dy (logand mask (logxor ly ry)))
         (dz (logand mask (logxor lz rz)))
         (df (logand mask (logxor lf rf))))
    (values
     (if (zerop (logxor lf df)) nil
         (ec-jacobian (logxor lx dx) (logxor ly dy) (logxor lz dz)))
     (if (zerop (logxor rf df)) nil
         (ec-jacobian (logxor rx dx) (logxor ry dy) (logxor rz dz))))))
(defun ec-jacobian-ladder (k q c bits)
  ;; Scalar bits select only the arithmetic-mask swap; the loop width is fixed.
  (let* ((r0 (ec-jacobian-point q))
         (r1 (ec-jacobian-double r0 c)))
    (loop for i downfrom (- bits 2) to 0 do
      (let ((bit (ldb (byte 1 i) k)))
        (multiple-value-setq (r0 r1) (ec-jacobian-cswap r0 r1 bit))
        (let ((sum (ec-jacobian-add r0 r1 c))
              (double (ec-jacobian-double r0 c)))
          (setf r1 sum r0 double))
        (multiple-value-setq (r0 r1) (ec-jacobian-cswap r0 r1 bit))))
    r0))
(defun ec-jacobian-affine (q c)
  (when q
    (let* ((z (ec-jacobian-z q))
           (zi (ec-inv z c))
           (zi2 (ec-mod (* zi zi) c)))
      (ec-point (ec-mod (* (ec-jacobian-x q) zi2) c)
                (ec-mod (* (ec-jacobian-y q) zi2 zi) c)))))
(defun ec-add (p q c)
  (cond ((null p) q) ((null q) p)
        ((= (car p) (car q))
         (if (= (mod (+ (cdr p) (cdr q)) (ec-curve-prime c)) 0) nil
             (let* ((m (ec-mod (* (+ (* 3 (expt (car p) 2)) (ec-curve-a c))
                                   (ec-inv (* 2 (cdr p)) c)) c))
                    (x (ec-mod (- (expt m 2) (* 2 (car p))) c)))
               (ec-point x (ec-mod (- (* m (- (car p) x)) (cdr p)) c)))))
        (t (let* ((m (ec-mod (* (- (cdr q) (cdr p))
                                (ec-inv (- (car q) (car p)) c)) c))
                   (x (ec-mod (- (expt m 2) (car p) (car q)) c)))
             (ec-point x (ec-mod (- (* m (- (car p) x)) (cdr p)) c))))))

(defun ec-on-curve-p (q c)
  (and q (integerp (car q)) (integerp (cdr q))
       (< (car q) (ec-curve-prime c)) (< (cdr q) (ec-curve-prime c))
       (= (mod (ec-pow (cdr q) 2 c) (ec-curve-prime c))
          (mod (+ (ec-pow (car q) 3 c)
                  (* (ec-curve-a c) (car q)) (ec-curve-b c)) (ec-curve-prime c)))))

(defun ec-cswap (left right bit)
  ;; The scalar bit selects with a mask. Bignum arithmetic remains
  ;; implementation-dependent in timing; the ladder removes explicit
  ;; secret-dependent control flow and table lookups from this operation.
  (let* ((mask (- bit))
         (lx (if left (car left) 0)) (ly (if left (cdr left) 0))
         (rx (if right (car right) 0)) (ry (if right (cdr right) 0))
         (lf (if left 1 0)) (rf (if right 1 0))
         (dx (logand mask (logxor lx rx))) (dy (logand mask (logxor ly ry)))
         (df (logand mask (logxor lf rf))))
    (values (if (zerop (logxor lf df)) nil (cons (logxor lx dx) (logxor ly dy)))
            (if (zerop (logxor rf df)) nil (cons (logxor rx dx) (logxor ry dy))))))

(defun ec-mul (k q c &key fixed)
  (let ((r0 nil) (r1 q) (bits (or fixed (integer-length k))))
    (loop for i downfrom (1- bits) to 0 do
      (let ((bit (ldb (byte 1 i) k)))
        (multiple-value-setq (r0 r1) (ec-cswap r0 r1 bit))
        (let ((sum (ec-add r0 r1 c)) (double (ec-add r0 r0 c)))
          (setf r1 sum r0 double))
        (multiple-value-setq (r0 r1) (ec-cswap r0 r1 bit)))) r0))

(defun ec-octets-int (v) (read-be v 0 (length v)))
(defun ec-int-octets (x n) (put-be x n))
(defun ec-decode-point (octets c)
  (let ((n (ec-curve-size c)))
    (unless (and (= (length octets) (1+ (* 2 n))) (= (aref octets 0) 4))
      (crypto-error "Invalid uncompressed EC point encoding"))
    (let ((q (ec-point (read-be octets 1 n) (read-be octets (1+ n) n))))
      (unless (ec-on-curve-p q c) (crypto-error "EC point is not on curve")) q)))
(defun ec-encode-point (q c)
  (unless (ec-on-curve-p q c) (crypto-error "Cannot encode invalid EC point"))
  (concat-octets #(4) (ec-int-octets (car q) (ec-curve-size c))
                 (ec-int-octets (cdr q) (ec-curve-size c))))

(defun p256-ecdh (private-key public-key)
  (let* ((q (ec-decode-point public-key +p256+))
         (k (if (arrayp private-key)
                (progn
                  (unless (= (length private-key) 32)
                    (crypto-error "Invalid P-256 private key length"))
                  (ec-octets-int private-key))
                private-key)))
    (unless (and (integerp k) (> k 0) (< k (ec-curve-n +p256+)))
      (crypto-error "Invalid P-256 private scalar"))
    ;; Adding 3n preserves kP and keeps the 258-bit ladder width fixed.
    (let ((shared (ec-jacobian-affine
                   (ec-jacobian-ladder (+ (* 3 (ec-curve-n +p256+)) k)
                                       q +p256+ 258)
                   +p256+)))
      (unless shared (crypto-error "Invalid EC shared point"))
      (ec-int-octets (car shared) 32))))
(defconstant +ec-limb-bits+ 13)
(defconstant +ec-limb-base+ (ash 1 +ec-limb-bits+))
(defconstant +ec-limb-mask+ (1- +ec-limb-base+))
(defstruct (ec-mod-context
             (:constructor %make-ec-mod-context
                 (modulus limb-count modulus-limbs n0-inverse r2 montgomery-one)))
  modulus limb-count modulus-limbs n0-inverse r2 montgomery-one)
(defun %ec-limbs-from-public-integer (value limb-count)
  (let ((result (make-array limb-count :initial-element 0)))
    (loop for i below limb-count do
      (setf (aref result i) (logand value +ec-limb-mask+)
            value (ash value (- +ec-limb-bits+))))
    result))
(defun %ec-limbs-from-octets (octets limb-count)
  (let ((result (make-array limb-count :initial-element 0)))
    (loop for byte-index below (length octets) do
      (loop for bit-index downfrom 7 to 0 do
        (let ((carry (ldb (byte 1 bit-index) (aref octets byte-index))))
          (loop for limb-index below limb-count do
            (let ((value (+ (* 2 (aref result limb-index)) carry)))
              (setf (aref result limb-index) (logand value +ec-limb-mask+)
                    carry (ash value (- +ec-limb-bits+))))))))
    result))
(defun %ec-limbs-bit (limbs bit-index)
  (ldb (byte 1 (mod bit-index +ec-limb-bits+))
       (aref limbs (floor bit-index +ec-limb-bits+))))
(defun %ec-limbs-one (limb-count)
  (let ((result (make-array limb-count :initial-element 0)))
    (setf (aref result 0) 1)
    result))
(defun %ec-limbs-to-octets (limbs size)
  (let ((result (make-array size :element-type '(unsigned-byte 8)))
        (bit-count (* 8 size)))
    (loop for byte-index below size do
      (let ((value 0))
        (loop for bit-offset below 8 do
          (let ((source-index
                  (- bit-count 1 (+ (* byte-index 8) bit-offset))))
            (setf value
                  (+ (* 2 value)
                     (%ec-limbs-bit limbs source-index)))))
        (setf (aref result byte-index) value)))
    result))
(defun %ec-limbs-select (left right bit)
  (let* ((mask (- bit))
         (result (make-array (length left) :initial-element 0)))
    (loop for i below (length left) do
      (setf (aref result i)
            (logxor (aref left i)
                    (logand mask (logxor (aref left i) (aref right i))))))
    result))
(defun %ec-limbs-add-raw (left right)
  (let ((result (make-array (length left) :initial-element 0))
        (carry 0))
    (loop for i below (length left) do
      (let ((sum (+ (aref left i) (aref right i) carry)))
        (setf (aref result i) (logand sum +ec-limb-mask+)
              carry (ash sum (- +ec-limb-bits+)))))
    (values result carry)))
(defun %ec-limbs-sub-raw (left right)
  (let ((result (make-array (length left) :initial-element 0))
        (borrow 0))
    (loop for i below (length left) do
      (let* ((difference (- (aref left i) (aref right i) borrow))
             (next-borrow (ldb (byte 1 63) difference)))
        (setf (aref result i) (logand difference +ec-limb-mask+)
              borrow next-borrow)))
    (values result borrow)))
(defun %ec-limbs-zero-bit (limbs)
  (let ((combined 0))
    (loop for i below (length limbs) do
      (setf combined (logior combined (aref limbs i))))
    (logxor 1 (logand 1 (ash (logior combined (- combined)) -63)))))
(defun %ec-limbs-valid-scalar-bit (scalar context)
  (multiple-value-bind (difference borrow)
      (%ec-limbs-sub-raw scalar (ec-mod-context-modulus-limbs context))
    (declare (ignore difference))
    (logand borrow (logxor 1 (%ec-limbs-zero-bit scalar)))))
(defun %ec-modular-add (left right context)
  (multiple-value-bind (sum carry) (%ec-limbs-add-raw left right)
    (declare (ignore carry))
    (multiple-value-bind (difference borrow)
        (%ec-limbs-sub-raw sum (ec-mod-context-modulus-limbs context))
      (%ec-limbs-select difference sum borrow))))
(defun %ec-modular-subtract (left right context)
  (multiple-value-bind (difference borrow) (%ec-limbs-sub-raw left right)
    (let ((correction (%ec-limbs-select
                       (make-array (length left) :initial-element 0)
                       (ec-mod-context-modulus-limbs context) borrow)))
      (multiple-value-bind (result carry) (%ec-limbs-add-raw difference correction)
        (declare (ignore carry))
        result))))
(defun %ec-montgomery-context (modulus size)
  (let* ((limb-count (ceiling (* 8 size) +ec-limb-bits+))
         (modulus-limbs (%ec-limbs-from-public-integer modulus limb-count))
         (inverse 1))
    (loop repeat 4 do
      (setf inverse
            (logand (* inverse (- 2 (* (aref modulus-limbs 0) inverse)))
                    +ec-limb-mask+)))
    (let* ((n0-inverse (logand (- inverse) +ec-limb-mask+))
           (radix (expt +ec-limb-base+ limb-count))
           (r2 (%ec-limbs-from-public-integer
                (mod (* radix radix) modulus) limb-count))
           (montgomery-one (%ec-limbs-from-public-integer
                            (mod radix modulus) limb-count)))
      (%make-ec-mod-context modulus limb-count modulus-limbs n0-inverse
                            r2 montgomery-one))))
(defun %ec-field-context (curve)
  (or (ec-curve-field-context curve)
      (let ((context (%ec-montgomery-context (ec-curve-prime curve)
                                             (ec-curve-size curve))))
        (setf (ec-curve-field-context curve) context
              (ec-curve-field-b curve)
              (%ec-montgomery-multiply
               (%ec-limbs-from-public-integer
                (ec-curve-b curve) (ec-mod-context-limb-count context))
               (ec-mod-context-r2 context) context))
        context)))
(defun %ec-order-context (curve)
  (or (ec-curve-order-context curve)
      (setf (ec-curve-order-context curve)
            (%ec-montgomery-context (ec-curve-n curve)
                                   (ec-curve-size curve)))))
(defun %ec-montgomery-multiply (left right context)
  (let* ((limb-count (ec-mod-context-limb-count context))
         (product (make-array (+ (* 2 limb-count) 2) :initial-element 0))
         (modulus (ec-mod-context-modulus-limbs context)))
    (loop for i below limb-count do
      (let ((carry 0))
        (loop for j below limb-count do
          (let* ((position (+ i j))
                 (value (+ (aref product position)
                           (* (aref left i) (aref right j)) carry)))
            (setf (aref product position) (logand value +ec-limb-mask+)
                  carry (ash value (- +ec-limb-bits+)))))
        (loop for position from (+ i limb-count) below (length product) do
          (let ((value (+ (aref product position) carry)))
            (setf (aref product position) (logand value +ec-limb-mask+)
                  carry (ash value (- +ec-limb-bits+)))))))
    (loop for i below limb-count do
      (let ((quotient
              (logand (* (aref product i) (ec-mod-context-n0-inverse context))
                      +ec-limb-mask+))
            (carry 0))
        (loop for j below limb-count do
          (let* ((position (+ i j))
                 (value (+ (aref product position)
                           (* quotient (aref modulus j)) carry)))
            (setf (aref product position) (logand value +ec-limb-mask+)
                  carry (ash value (- +ec-limb-bits+)))))
        (loop for position from (+ i limb-count) below (length product) do
          (let ((value (+ (aref product position) carry)))
            (setf (aref product position) (logand value +ec-limb-mask+)
                  carry (ash value (- +ec-limb-bits+)))))))
    (let ((reduced (make-array limb-count :initial-element 0)))
      (loop for i below limb-count do
        (setf (aref reduced i) (aref product (+ i limb-count))))
      (multiple-value-bind (difference borrow)
          (%ec-limbs-sub-raw reduced modulus)
        (%ec-limbs-select difference reduced borrow)))))
(defun %ec-to-montgomery (value context)
  (%ec-montgomery-multiply value (ec-mod-context-r2 context) context))
(defun %ec-from-montgomery (value context)
  (let ((normal-one (make-array (ec-mod-context-limb-count context)
                                :initial-element 0)))
    (setf (aref normal-one 0) 1)
    (%ec-montgomery-multiply value normal-one context)))
(defun %ec-montgomery-power (base exponent context bit-count)
  (let ((result (ec-mod-context-montgomery-one context)))
    (loop for i downfrom (1- bit-count) to 0 do
      (setf result (%ec-montgomery-multiply result result context))
      (let ((product (%ec-montgomery-multiply result base context)))
        (setf result (%ec-limbs-select result product
                                       (%ec-limbs-bit exponent i)))))
    result))
(defstruct (ec-projective (:constructor ec-projective (x y z)) (:copier nil)) x y z)
(defun %ec-fadd (x y curve)
  (%ec-modular-add x y (%ec-field-context curve)))
(defun %ec-fsub (x y curve)
  (%ec-modular-subtract x y (%ec-field-context curve)))
(defun %ec-fmul (x y curve)
  (%ec-montgomery-multiply x y (%ec-field-context curve)))
(defun ec-projective-add (left right curve)
  ;; Complete Renes-Costello-Batina addition for the a=-3 NIST curves.
  (let* ((x1 (ec-projective-x left)) (y1 (ec-projective-y left))
         (z1 (ec-projective-z left)) (x2 (ec-projective-x right))
         (y2 (ec-projective-y right)) (z2 (ec-projective-z right))
         (b (progn (%ec-field-context curve) (ec-curve-field-b curve)))
         (u0 0) (u1 0) (u2 0) (u3 0) (u4 0)
         (x3 0) (y3 0) (z3 0))
    (setf u0 (%ec-fmul x1 x2 curve)
          u1 (%ec-fmul y1 y2 curve)
          u2 (%ec-fmul z1 z2 curve)
          u3 (%ec-fadd x1 y1 curve)
          u4 (%ec-fadd x2 y2 curve)
          u3 (%ec-fsub (%ec-fmul u3 u4 curve)
                       (%ec-fadd u0 u1 curve) curve)
          u4 (%ec-fadd y1 z1 curve)
          x3 (%ec-fadd y2 z2 curve)
          u4 (%ec-fsub (%ec-fmul u4 x3 curve)
                       (%ec-fadd u1 u2 curve) curve)
          x3 (%ec-fadd x1 z1 curve)
          y3 (%ec-fadd x2 z2 curve)
          x3 (%ec-fmul x3 y3 curve)
          y3 (%ec-fsub x3 (%ec-fadd u0 u2 curve) curve)
          z3 (%ec-fmul b u2 curve)
          x3 (%ec-fsub y3 z3 curve)
          z3 (%ec-fadd x3 x3 curve)
          x3 (%ec-fadd x3 z3 curve)
          z3 (%ec-fsub u1 x3 curve)
          x3 (%ec-fadd u1 x3 curve)
          y3 (%ec-fmul b y3 curve)
          u1 (%ec-fadd u2 u2 curve)
          u2 (%ec-fadd u1 u2 curve)
          y3 (%ec-fsub y3 u2 curve)
          y3 (%ec-fsub y3 u0 curve)
          u1 (%ec-fadd y3 y3 curve)
          y3 (%ec-fadd u1 y3 curve)
          u1 (%ec-fadd u0 u0 curve)
          u0 (%ec-fadd u1 u0 curve)
          u0 (%ec-fsub u0 u2 curve)
          u1 (%ec-fmul u4 y3 curve)
          u2 (%ec-fmul u0 y3 curve)
          y3 (%ec-fadd (%ec-fmul x3 z3 curve) u2 curve)
          x3 (%ec-fsub (%ec-fmul u3 x3 curve) u1 curve)
          z3 (%ec-fadd (%ec-fmul u4 z3 curve)
                       (%ec-fmul u3 u0 curve) curve))
    (ec-projective x3 y3 z3)))
(defun ec-projective-double (point curve)
  (let* ((x (ec-projective-x point)) (y (ec-projective-y point))
         (z (ec-projective-z point))
         (b (progn (%ec-field-context curve) (ec-curve-field-b curve)))
         (u0 0) (u1 0) (u2 0) (u3 0)
         (x3 0) (y3 0) (z3 0))
    (setf u0 (%ec-fmul x x curve)
          u1 (%ec-fmul y y curve)
          u2 (%ec-fmul z z curve)
          u3 (%ec-fmul x y curve)
          u3 (%ec-fadd u3 u3 curve)
          z3 (%ec-fmul x z curve)
          z3 (%ec-fadd z3 z3 curve)
          y3 (%ec-fmul b u2 curve)
          y3 (%ec-fsub y3 z3 curve)
          x3 (%ec-fadd y3 y3 curve)
          y3 (%ec-fadd x3 y3 curve)
          x3 (%ec-fsub u1 y3 curve)
          y3 (%ec-fadd u1 y3 curve)
          y3 (%ec-fmul x3 y3 curve)
          x3 (%ec-fmul x3 u3 curve)
          u3 (%ec-fadd u2 u2 curve)
          u2 (%ec-fadd u2 u3 curve)
          z3 (%ec-fmul b z3 curve)
          z3 (%ec-fsub z3 u2 curve)
          z3 (%ec-fsub z3 u0 curve)
          u3 (%ec-fadd z3 z3 curve)
          z3 (%ec-fadd z3 u3 curve)
          u3 (%ec-fadd u0 u0 curve)
          u0 (%ec-fadd u3 u0 curve)
          u0 (%ec-fsub u0 u2 curve)
          u0 (%ec-fmul u0 z3 curve)
          y3 (%ec-fadd y3 u0 curve)
          u0 (%ec-fmul y z curve)
          u0 (%ec-fadd u0 u0 curve)
          z3 (%ec-fmul u0 z3 curve)
          x3 (%ec-fsub x3 z3 curve)
          z3 (%ec-fmul u0 u1 curve)
          z3 (%ec-fadd z3 z3 curve)
          z3 (%ec-fadd z3 z3 curve))
    (ec-projective x3 y3 z3)))
(defun ec-projective-cswap (left right bit)
  (values (ec-projective (%ec-limbs-select (ec-projective-x left)
                                           (ec-projective-x right) bit)
                         (%ec-limbs-select (ec-projective-y left)
                                           (ec-projective-y right) bit)
                         (%ec-limbs-select (ec-projective-z left)
                                           (ec-projective-z right) bit))
          (ec-projective (%ec-limbs-select (ec-projective-x right)
                                           (ec-projective-x left) bit)
                         (%ec-limbs-select (ec-projective-y right)
                                           (ec-projective-y left) bit)
                         (%ec-limbs-select (ec-projective-z right)
                                           (ec-projective-z left) bit))))
(defun %ec-secret-scalar-mul (scalar point curve)
  (let* ((context (%ec-field-context curve))
         (bits (* 8 (ec-curve-size curve)))
         (zero (make-array (ec-mod-context-limb-count context) :initial-element 0))
         (r0 (ec-projective zero (ec-mod-context-montgomery-one context) zero))
         (r1 (ec-projective
              (%ec-to-montgomery
               (%ec-limbs-from-public-integer (car point)
                                              (ec-mod-context-limb-count context))
               context)
              (%ec-to-montgomery
               (%ec-limbs-from-public-integer (cdr point)
                                              (ec-mod-context-limb-count context))
               context)
              (ec-mod-context-montgomery-one context))))
    (loop for i downfrom (1- bits) to 0 do
      (let ((bit (%ec-limbs-bit scalar i)))
        (multiple-value-setq (r0 r1) (ec-projective-cswap r0 r1 bit))
        (let ((sum (ec-projective-add r0 r1 curve))
              (double (ec-projective-double r0 curve)))
          (setf r1 sum r0 double))
        (multiple-value-setq (r0 r1) (ec-projective-cswap r0 r1 bit))))
    r0))
(defun %ec-projective-affine (point curve)
  (let* ((context (%ec-field-context curve))
         (exponent (%ec-limbs-from-public-integer
                    (- (ec-curve-prime curve) 2)
                    (ec-mod-context-limb-count context)))
         (inverse (%ec-montgomery-power
                   (ec-projective-z point) exponent context
                   (* 8 (ec-curve-size curve))))
         (x (%ec-montgomery-multiply
             (ec-projective-x point) inverse context))
         (y (%ec-montgomery-multiply
             (ec-projective-y point) inverse context)))
    (ec-point (%ec-from-montgomery x context)
              (%ec-from-montgomery y context))))
(defun %ec-private-scalar (private-key curve)
  (unless (typep private-key '(vector (unsigned-byte 8)))
    (crypto-error "EC private keys must be fixed-width octet vectors"))
  (let* ((size (ec-curve-size curve))
         (context (%ec-order-context curve)))
    (unless (= (length private-key) size)
      (crypto-error "Invalid EC private key length"))
    (let* ((scalar (%ec-limbs-from-octets
                    private-key (ec-mod-context-limb-count context)))
           (valid (%ec-limbs-valid-scalar-bit scalar context))
           (safe-scalar (%ec-limbs-select
                         (%ec-limbs-one (ec-mod-context-limb-count context))
                         scalar valid)))
      (values safe-scalar valid))))
(defun %ec-public-from-scalar-limbs (curve scalar)
  (let* ((base (ec-point (ec-curve-gx curve) (ec-curve-gy curve)))
         (point (%ec-projective-affine
                 (%ec-secret-scalar-mul scalar base curve) curve)))
    (concat-octets #(4)
                   (%ec-limbs-to-octets (car point) (ec-curve-size curve))
                   (%ec-limbs-to-octets (cdr point) (ec-curve-size curve)))))
(defun %ec-public-from-scalar (curve private-key)
  (multiple-value-bind (scalar valid) (%ec-private-scalar private-key curve)
    (let ((public-key (%ec-public-from-scalar-limbs curve scalar)))
      (unless (= valid 1)
        (crypto-error "Invalid EC private scalar"))
      public-key)))
