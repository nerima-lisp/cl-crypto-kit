(defpackage #:crypto-kit/test (:use #:cl #:crypto-kit) (:export #:run-tests))
(in-package #:crypto-kit/test)

(defun bytes (hex)
  (let ((out (make-array (/ (length hex) 2) :element-type '(unsigned-byte 8))))
    (dotimes (i (length out) out) (setf (aref out i) (parse-integer hex :start (* i 2) :end (+ (* i 2) 2) :radix 16)))))
(defun ascii (s) (map '(vector (unsigned-byte 8)) #'char-code s))
(defun check (ok message) (unless ok (error "~A" message)))
(defun check-hex (actual expected label) (check (equalp actual (bytes expected)) label))

(defun run-tests ()
  (dolist (pair '((:sha1 "da39a3ee5e6b4b0d3255bfef95601890afd80709")
                  (:sha256 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
                  (:sha384 "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
                  (:sha512 "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")))
    (check-hex (digest (first pair) (ascii "")) (second pair) (princ-to-string pair)))
  (check-hex (hmac :sha256 (bytes "4a656665") (ascii "what do ya want for nothing?")) "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" "RFC 4231 HMAC")
  (let ((prk (hkdf-extract :sha256 (bytes "000102030405060708090a0b0c")
                           (bytes "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"))))
    (check-hex prk "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5" "RFC 5869 extract")
    (check-hex (hkdf-expand :sha256 prk (bytes "f0f1f2f3f4f5f6f7f8f9") 42) "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865" "RFC 5869 expand"))
  (let ((state (make-digest :sha256))) (digest-update state (ascii "abc")) (check-hex (digest-final (digest-copy state)) "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" "incremental"))
  (format t "cl-crypto-kit: 8 tests passed~%") t)
