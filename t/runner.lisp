(in-package #:crypto-kit/test)
(defun run-tests ()
  (run-gcm-disassembly-tests)
  (run-vector-tests)
  (setf *signature-test-count* 0)
  (run-ec-sign-keygen-tests)
  (run-ed25519-sign-tests)
  (run-key-api-tests)
  (format t "cl-crypto-kit: Signature checks ~D passed~%" *signature-test-count*)
  (unless (run-all :reporter :spec :pass-with-no-tests nil)
    (error "cl-crypto-kit tests failed."))
  t)
