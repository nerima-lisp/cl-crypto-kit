(defun run-nist-shavs-tests ()
  (dolist (vector +nist-shavs+)
    (destructuring-bind (algorithm message expected) vector
      (checkv (digest algorithm (bytes message)) expected "NIST SHAVS")))
  (format t "cl-crypto-kit: NIST SHAVS ~D selected short/long vectors passed~%"
          (length +nist-shavs+))
  t)
